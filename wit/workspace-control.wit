package memeloop:workspace-control@0.2.0;

interface types {
  record create-context {
    installation-id: string,
    actor-user-id: string,
    organization-id: string,
    owner-id: string,
    template-id: string,
    configuration-json: string,
  }

  record workspace-plan {
    name: string,
    image: string,
    access-mode: string,
    cpu-millis: u64,
    memory-mib: u64,
    gpu-count: u32,
    disk-gib: u64,
    buildkit-enabled: bool,
    cluster-access: bool,
  }

  record decision {
    allow: bool,
    /// Must be predeclared in plugin.json. No guest free text crosses the ABI.
    code: option<string>,
  }

  record request-context {
    installation-id: string,
    actor-user-id: option<string>,
    organization-id: option<string>,
    method: string,
    path: string,
    configuration-json: string,
  }

  record api-request {
    context: request-context,
    route-id: string,
    body: list<u8>,
  }

  record api-response {
    status: u16,
    content-type: string,
    body: list<u8>,
  }
}

interface plugin-backend {
  use types.{create-context, workspace-plan, decision, request-context, api-request, api-response};
  admit-create: func(context: create-context, plan: workspace-plan) -> result<decision, string>;
  handle-api: func(request: api-request) -> result<api-response, string>;
  check-request: func(context: request-context) -> result<decision, string>;
}

world plugin {
  export plugin-backend;
}
