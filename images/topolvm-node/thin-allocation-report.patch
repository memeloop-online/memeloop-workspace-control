diff --git a/internal/lvmd/command/lvm.go b/internal/lvmd/command/lvm.go
index 691e17c..395a093 100644
--- a/internal/lvmd/command/lvm.go
+++ b/internal/lvmd/command/lvm.go
@@ -243,0 +244,17 @@ func (vg *VolumeGroup) FindPool(ctx context.Context, name string) (*ThinPool, er
+// ReadThinPoolForAllocation reads the pool and all its members in one LVM report.
+// The returned pool uses fresh LVM queries for any later operation.
+func ReadThinPoolForAllocation(ctx context.Context, vgName, poolName string) (*ThinPool, *ThinPoolUsage, error) {
+	lvs, err := getLVReport(ctx, vgName)
+	if err != nil {
+		return nil, nil, err
+	}
+	group := &VolumeGroup{state: vg{name: vgName}, reportLvs: lvs}
+	pool, err := group.FindPool(ctx, poolName)
+	if err != nil {
+		return nil, nil, err
+	}
+	usage, err := pool.Usage(ctx)
+	group.reportLvs = nil
+	return pool, usage, err
+}
+
