diff --git a/internal/lvmd/pool.go b/internal/lvmd/pool.go
index 4dc3498..f2e1038 100644
--- a/internal/lvmd/pool.go
+++ b/internal/lvmd/pool.go
@@ -36,0 +37,18 @@ func storagePoolForDeviceClass(ctx context.Context, dc *lvmdTypes.DeviceClass) (
+func storagePoolForAllocation(ctx context.Context, dc *lvmdTypes.DeviceClass) (storagePool, uint64, error) {
+	if dc.Type == lvmdTypes.TypeThin {
+		config := dc.ThinPoolConfig
+		pool, usage, err := command.ReadThinPoolForAllocation(ctx, dc.VolumeGroup, config.Name)
+		if err != nil {
+			return nil, 0, err
+		}
+		free, err := usage.FreeBytes(config.OverprovisionRatio)
+		return &thinPoolAdapter{pool, config.OverprovisionRatio}, free, err
+	}
+	pool, err := storagePoolForDeviceClass(ctx, dc)
+	if err != nil {
+		return nil, 0, err
+	}
+	free, err := pool.Free(ctx)
+	return pool, free, err
+}
+
