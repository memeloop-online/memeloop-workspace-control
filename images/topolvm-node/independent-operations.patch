+func (s *nodeServer) lock(volumeID, path string) func() {
+	path = filepath.Clean(path)
+	s.volumes.LockByID(volumeID)
+	s.targets.LockByID(path)
+	return func() {
+		s.targets.UnlockByID(path)
+		s.volumes.UnlockByID(volumeID)
+	}
