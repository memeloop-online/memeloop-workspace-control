 package driver
 
 import (
+	"context"
+	"sync"
 	"testing"
+	"time"
 
 	"github.com/container-storage-interface/spec/lib/go/csi"
 )
 
+type blockingNodeFixture struct {
+	csi.UnimplementedNodeServer
+	started chan string
+	release <-chan struct{}
+}
+
+func (f blockingNodeFixture) NodePublishVolume(_ context.Context, req *csi.NodePublishVolumeRequest) (*csi.NodePublishVolumeResponse, error) {
+	f.started <- req.GetTargetPath()
+	if req.GetTargetPath() == "/home" {
+		<-f.release
+	}
+	return &csi.NodePublishVolumeResponse{}, nil
+}
+
+func (f blockingNodeFixture) NodeUnpublishVolume(_ context.Context, req *csi.NodeUnpublishVolumeRequest) (*csi.NodeUnpublishVolumeResponse, error) {
+	f.started <- req.GetTargetPath()
+	return &csi.NodeUnpublishVolumeResponse{}, nil
+}
+
+func TestIndependentNodeVolumesCanMountTogether(t *testing.T) {
+	started := make(chan string, 4)
+	release := make(chan struct{})
+	open := sync.OnceFunc(func() { close(release) })
+	defer open()
+	server := &nodeServer{
+		volumes: NewLockWithID(),
+		targets: NewLockWithID(),
+		server:  blockingNodeFixture{started: started, release: release},
+	}
+	ctx := context.Background()
+	publish := func(id, path string) {
+		_, _ = server.NodePublishVolume(ctx, &csi.NodePublishVolumeRequest{VolumeId: id, TargetPath: path})
+	}
+	unpublish := func(id, path string) {
+		_, _ = server.NodeUnpublishVolume(ctx, &csi.NodeUnpublishVolumeRequest{VolumeId: id, TargetPath: path})
+	}
+	next := func() string {
+		t.Helper()
+		select {
+		case path := <-started:
+			return path
+		case <-time.After(2 * time.Second):
+			t.Fatal("no node RPC reached the driver")
+			return ""
+		}
+	}
+	go publish("home", "/home")
+	if got := next(); got != "/home" {
+		t.Fatalf("first target = %q; want /home", got)
+	}
+	go unpublish("home", "/previous-home")
+	go publish("different-volume", "/./home")
+	go publish("scratch", "/scratch")
+	if got := next(); got != "/scratch" {
+		t.Fatalf("independent scratch mount was not first; entered %q", got)
+	}
+	select {
+	case got := <-started:
+		t.Fatalf("overlapping volume or target reached the driver before Home completed: %q", got)
+	case <-time.After(50 * time.Millisecond):
+	}
+	open()
+	a, b := next(), next()
+	if !((a == "/previous-home" && b == "/./home") || (b == "/previous-home" && a == "/./home")) {
+		t.Fatalf("pending requests did not complete: %q, %q", a, b)
+	}
+}
+
