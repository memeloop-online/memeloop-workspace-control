#!/bin/sh
set -eu

workspace_user=${MWC_WORKSPACE_USER:-workspace}
workspace_root=${MWC_WORKSPACE_HOME:-/workspace}
workspace_group=$(id -gn "$workspace_user")
state_dir="$workspace_root/.mwc"
authorized_keys="$state_dir/authorized_keys"
runtime_dir=/run/mwc-ssh
manifest=/var/run/workspace-injections/config/workspace-files.json
environment_manifest=/var/run/workspace-injections/config/workspace-environment.json
kubeconfig="$state_dir/kubeconfig"
runtime_sshd_config="$runtime_dir/sshd_config"

prepare_layout() {
    if [ "${MWC_PRESERVE_HOME_ROOT:-false}" = true ]; then
        # A migrated Coder PVC root is intentionally root:1000/2775. Do not rewrite it;
        # only create and own platform-managed children beneath that mount.
        mkdir -p "$workspace_root"
    else
        install -d -m 0750 -o "$workspace_user" -g "$workspace_group" "$workspace_root"
    fi
    install -d -m 0700 -o "$workspace_user" -g "$workspace_group" "$state_dir"
    # These PVC subdirectories are mounted as /tmp and /var/tmp. Keep normal sticky
    # world-writable semantics so the compatibility package manager and image user can both use
    # them; the BuildKit-only directory remains private.
    install -d -m 1777 -o "$workspace_user" -g "$workspace_group" \
        "$workspace_root/.tmp/dev" "$workspace_root/.tmp/var"
    install -d -m 0700 -o "$workspace_user" -g "$workspace_group" \
        "$workspace_root/.tmp/buildkit"
    install -d -m 0700 "$runtime_dir"
}

prepare_kubeconfig() {
    if [ "${MWC_IN_CLUSTER_KUBECONFIG:-false}" != true ]; then
        rm -f "$kubeconfig"
        return
    fi
    temporary_kubeconfig="$state_dir/.kubeconfig.tmp"
    cat > "$temporary_kubeconfig" <<'EOF'
apiVersion: v1
kind: Config
clusters:
  - name: in-cluster
    cluster:
      certificate-authority: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
      server: https://kubernetes.default.svc
users:
  - name: workspace-admin
    user:
      tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
contexts:
  - name: workspace-admin@in-cluster
    context:
      cluster: in-cluster
      user: workspace-admin
current-context: workspace-admin@in-cluster
EOF
    install -m 0600 -o "$workspace_user" -g "$workspace_group" \
        "$temporary_kubeconfig" "$kubeconfig"
    rm -f "$temporary_kubeconfig"
}

prepare() {
    prepare_layout
    prepare_kubeconfig

    # Debian images commonly create service users with a leading `!` in shadow. sshd treats that
    # as a fully locked account and rejects public keys before checking authorized_keys. Replace
    # only that marker with an unusable password hash; password and keyboard authentication stay
    # disabled in the platform sshd_config.
    if command -v usermod >/dev/null 2>&1; then
        shadow_password=$(getent shadow "$workspace_user" | cut -d: -f2)
        case "$shadow_password" in
            !*) usermod -p '*' "$workspace_user" ;;
        esac
    fi

    if [ ! -s "$runtime_dir/ttyd_client_key" ]; then
        ssh-keygen -q -t ed25519 -N '' -f "$runtime_dir/ttyd_client_key"
    fi
    # Kubernetes may mirror owner permissions to the Pod fsGroup on projected Secret files.
    # OpenSSH correctly rejects a group-readable host private key, so copy it into the
    # Pod-lifetime EmptyDir and normalize the mode instead of serving directly from the Secret.
    install -m 0600 -o root -g root \
        /etc/ssh/platform/ssh_host_ed25519_key \
        "$runtime_dir/ssh_host_ed25519_key"
    install -m 0644 -o root -g root \
        /etc/ssh/platform/ssh_host_ed25519_key.pub \
        "$runtime_dir/ssh_host_ed25519_key.pub"

    : > "$authorized_keys"
    cat "$runtime_dir/ttyd_client_key.pub" >> "$authorized_keys"
    if [ -r "$manifest" ]; then
        jq -c '.files[]' "$manifest" | while IFS= read -r entry; do
            object=$(printf '%s' "$entry" | jq -r '.object')
            data_key=$(printf '%s' "$entry" | jq -r '.data_key')
            target=$(printf '%s' "$entry" | jq -r '.target')
            mode=$(printf '%s' "$entry" | jq -r '.mode // empty')
            owner=$(printf '%s' "$entry" | jq -r '.owner // empty')
            group=$(printf '%s' "$entry" | jq -r '.group // empty')
            if [ -z "$owner" ]; then
                owner=$workspace_user
            fi
            if [ -z "$group" ]; then
                group=$workspace_group
            fi
            kind=$(printf '%s' "$entry" | jq -r '.kind')
            case "$object" in
                secret) source=/var/run/workspace-injections/secret/$data_key ;;
                config_map) source=/var/run/workspace-injections/config/$data_key ;;
                *) echo "invalid injection object" >&2; exit 1 ;;
            esac
            if [ -z "$mode" ]; then
                case "$object" in
                    secret) mode=384 ;;
                    config_map) mode=420 ;;
                esac
            fi
            numeric_mode=$(printf '%o' "$mode")
            install -D -m "$numeric_mode" -o "$owner" -g "$group" "$source" "$target"
            if [ "$kind" = ssh_public_key ]; then
                cat "$source" >> "$authorized_keys"
                printf '\n' >> "$authorized_keys"
            fi
        done
    fi
    chown "$workspace_user:$workspace_group" "$authorized_keys"
    chmod 0600 "$authorized_keys"
    chmod 0600 "$runtime_dir/ttyd_client_key"
    printf 'localhost,127.0.0.1 ' > "$runtime_dir/known_hosts"
    cat "$runtime_dir/ssh_host_ed25519_key.pub" >> "$runtime_dir/known_hosts"
    chmod 0644 "$runtime_dir/known_hosts"
    prepare_runtime_sshd_config
}

prepare_runtime_sshd_config() {
    install -m 0600 -o root -g root /etc/workspace-platform/sshd_config "$runtime_sshd_config"
    if [ ! -r "$environment_manifest" ]; then
        return
    fi
    environment_count=$(jq -r '.environment | length' "$environment_manifest")
    environment_index=0
    while [ "$environment_index" -lt "$environment_count" ]; do
        entry=$(jq -c ".environment[$environment_index]" "$environment_manifest")
        environment_index=$((environment_index + 1))
        name=$(printf '%s' "$entry" | jq -r '.name')
        object=$(printf '%s' "$entry" | jq -r '.object')
        data_key=$(printf '%s' "$entry" | jq -r '.data_key')
        case "$name" in
            HOME|MWC_WORKSPACE_USER|MWC_WORKSPACE_HOME|MWC_IN_CLUSTER_KUBECONFIG|MWC_PRESERVE_HOME_ROOT|MWC_BUILDKIT_ENABLED)
                continue
                ;;
            KUBECONFIG)
                if [ "${MWC_IN_CLUSTER_KUBECONFIG:-false}" = true ]; then continue; fi
                ;;
            BUILDKIT_HOST)
                if [ "${MWC_BUILDKIT_ENABLED:-false}" = true ]; then continue; fi
                ;;
        esac
        case "$object" in
            secret) source=/var/run/workspace-injections/secret/$data_key ;;
            config_map) source=/var/run/workspace-injections/config/$data_key ;;
            *) echo "invalid environment injection object" >&2; exit 1 ;;
        esac
        value=$(cat "$source")
        escaped=$(printf '%s=%s' "$name" "$value" | sed 's/\\/\\\\/g; s/"/\\"/g')
        printf 'SetEnv "%s"\n' "$escaped" >> "$runtime_sshd_config"
    done
}

install_compat_openssh() {
    if [ ! -x /usr/sbin/sshd ] || ! command -v jq >/dev/null 2>&1; then
        if ! command -v apt-get >/dev/null 2>&1; then
            echo "workspace image must provide sshd and jq, or an apt-compatible package manager" >&2
            exit 69
        fi
        export DEBIAN_FRONTEND=noninteractive
        apt-get update
        apt-get install -y --no-install-recommends jq openssh-server
        rm -rf /var/lib/apt/lists/*
    fi
    mkdir -p /run/sshd
}

case "${1:-serve}" in
    prepare-layout) prepare_layout ;;
    prepare) prepare ;;
    serve)
        install_compat_openssh
        prepare
        exec /usr/sbin/sshd -D -e -f "$runtime_sshd_config"
        ;;
    # Kept as a command alias so an already-created Pod template can roll forward safely.
    compat-serve)
        install_compat_openssh
        prepare
        exec /usr/sbin/sshd -D -e -f "$runtime_sshd_config"
        ;;
    *) echo "usage: mwc-workspace-bootstrap prepare-layout|prepare|serve|compat-serve" >&2; exit 64 ;;
esac
