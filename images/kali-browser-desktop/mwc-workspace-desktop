#!/bin/sh
set -eu

desktop_port=${MWC_DESKTOP_PORT:-6080}
workspace_home=${MWC_WORKSPACE_HOME:-/workspace}
display=:1
vnc_port=5901
vnc_dir="$workspace_home/.config/tigervnc"
xstartup=/etc/mwc-desktop/xstartup
vnc_host=$(hostname)

case "$desktop_port" in
    *[!0-9]*|'')
        echo "MWC_DESKTOP_PORT must be a decimal TCP port" >&2
        exit 64
        ;;
esac
if [ "$desktop_port" -ne 6080 ]; then
    echo "Kali browser desktop requires MWC_DESKTOP_PORT=6080" >&2
    exit 64
fi

mkdir -p "$vnc_dir"
chmod 0700 "$vnc_dir"
rm -f "$vnc_dir/$vnc_host:1.pid" "$vnc_dir/$vnc_host:1.log"
export HOME="$workspace_home"
export USER="${MWC_WORKSPACE_USER:-workspace}"
export DISPLAY="$display"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/mwc-xdg-${USER}}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"

# shellcheck disable=SC2317
cleanup() {
    if [ -n "${websockify_pid:-}" ]; then
        kill "$websockify_pid" >/dev/null 2>&1 || true
    fi
    tigervncserver -kill "$display" >/dev/null 2>&1 || true
}
trap 'cleanup; exit 0' EXIT INT TERM HUP

# No VNC password is configured because this listener is strictly loopback-only
# inside the workspace Pod. Authentication is enforced by the outer HTTPS
# ticket before the controller forwards a browser request to noVNC.
tigervncserver "$display" \
    -localhost yes \
    -rfbport "$vnc_port" \
    -SecurityTypes None \
    -autokill yes \
    -geometry "${MWC_DESKTOP_GEOMETRY:-1440x900}" \
    -depth "${MWC_DESKTOP_DEPTH:-24}" \
    -xstartup "$xstartup"
vnc_pid=$(cat "$vnc_dir/$vnc_host:1.pid")

websockify --web /usr/share/novnc \
    "127.0.0.1:${desktop_port}" "127.0.0.1:${vnc_port}" &
websockify_pid=$!

while kill -0 "$vnc_pid" 2>/dev/null && kill -0 "$websockify_pid" 2>/dev/null; do
    sleep 2
done
exit 70
